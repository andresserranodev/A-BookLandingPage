---
import { cn } from "@/lib/utils";

type MarginBottom = "mb-4" | "mb-6" | "mb-8";

interface Props {
  testId: string;
  marginBottom?: MarginBottom;
  class?: string;
}

const { testId, marginBottom = "mb-6", class: className } = Astro.props;
---

<h2
  class={cn(
    "text-3xl font-bold text-foreground sm:text-4xl md:text-5xl",
    marginBottom,
    className
  )}
  data-testid={testId}
>
  <slot />
</h2>
