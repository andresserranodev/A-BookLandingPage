---
import BookPreviewCarousel from "./BookPreviewCarousel.astro";
import Section from "@/components/ui/section.astro";
import SectionHeading from "@/components/ui/section-heading.astro";
import { JOURNEY_STATS } from "@/lib/constants";
import { translations, type Language } from "@/lib/translations";

interface Props {
  lang?: Language;
}

const { lang = "es" } = Astro.props;
const t = translations[lang];
const stats = JOURNEY_STATS[lang];
---

<Section id="about" testId="section-about-book" maxWidth="max-w-6xl">
  <div
    class="grid grid-cols-1 items-center gap-8 md:gap-12 lg:grid-cols-2 lg:gap-16"
  >
    <div class="order-2 lg:order-1">
      <SectionHeading testId="text-about-heading" marginBottom="mb-6">
        {t.aboutBook.heading}
      </SectionHeading>
      <div
        class="space-y-4 text-base leading-relaxed text-muted-foreground md:text-lg"
      >
        <p data-testid="text-about-paragraph-1">{t.aboutBook.paragraph1}</p>
        <p data-testid="text-about-paragraph-2">{t.aboutBook.paragraph2}</p>
      </div>

      <div class="mt-8 grid grid-cols-3 gap-4 text-center">
        <div class="p-4" data-testid="stat-miles">
          <p class="text-2xl font-bold text-foreground sm:text-3xl">
            {stats.distance}
          </p>
          <p class="text-sm text-muted-foreground">
            {t.aboutBook.statMiles}
          </p>
        </div>
        <div class="p-4" data-testid="stat-countries">
          <p class="text-2xl font-bold text-foreground sm:text-3xl">
            {JOURNEY_STATS.countries}
          </p>
          <p class="text-sm text-muted-foreground">
            {t.aboutBook.statCountries}
          </p>
        </div>
        <div class="p-4" data-testid="stat-stories">
          <p class="text-2xl font-bold text-foreground sm:text-3xl">1</p>
          <p class="text-sm text-muted-foreground">
            {t.aboutBook.statJourney}
          </p>
        </div>
      </div>
    </div>

    <div class="order-1 flex flex-col items-center justify-center lg:order-2">
      <BookPreviewCarousel />
      <p class="mt-6 text-center text-sm font-medium text-muted-foreground">
        {t.aboutBook.available}
      </p>
    </div>
  </div>
</Section>
